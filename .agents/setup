#!/usr/bin/env bash
set -euo pipefail

readonly swamp_version="20260922.200837.0-sha.cd12d9b5"
readonly just_version="1.58.0"
readonly install_dir="${HOME}/.local/bin"
readonly swamp_bin="${install_dir}/swamp"
readonly deno_bin="${install_dir}/deno"
readonly just_bin="${install_dir}/just"

step() {
  printf '\n==> %s\n' "$1"
}

step "Checking system dependencies"
missing_packages=()
command -v curl >/dev/null 2>&1 || missing_packages+=(curl)
command -v openssl >/dev/null 2>&1 || missing_packages+=(openssl)

if ((${#missing_packages[@]})); then
  sudo apt-get update -qq
  sudo apt-get install -y "${missing_packages[@]}"
fi

mkdir -p "$install_dir"

step "Ensuring Swamp ${swamp_version} is installed"
installed_swamp_version=""
if [[ -x "$swamp_bin" ]]; then
  installed_swamp_version="$($swamp_bin --version 2>/dev/null || true)"
fi
if [[ "$installed_swamp_version" != *"$swamp_version"* ]]; then
  CI=1 curl -fsSL https://swamp.club/install.sh |
    CI=1 sh -s -- -V "$swamp_version" -d "$install_dir"
fi

step "Exposing Swamp's bundled Deno"
doctor_output="$($swamp_bin doctor extensions --json)"
deno_path="$(sed -n 's/.*"denoPath": "\([^"]*\)".*/\1/p' <<<"$doctor_output")"
if [[ -z "$deno_path" || ! -x "$deno_path" ]]; then
  printf 'Unable to locate Swamp bundled Deno\n' >&2
  exit 1
fi
ln -sfn "$deno_path" "$deno_bin"

step "Ensuring just ${just_version} is installed"
installed_just_version=""
if [[ -x "$just_bin" ]]; then
  installed_just_version="$($just_bin --version 2>/dev/null || true)"
fi
if [[ "$installed_just_version" != "just ${just_version}" ]]; then
  uv tool install --force "rust-just==${just_version}"
fi

step "Warming development dependencies"
uvx prek --version
(
  cd sprites
  cache_lock="$(mktemp)"
  trap 'rm -f "$cache_lock"' EXIT
  cp deno.lock "$cache_lock"
  "$deno_bin" cache --lock="$cache_lock" \
    extensions/models/*.ts \
    extensions/models/_lib/*.ts \
    scripts/*.ts
)

step "Orb setup complete"
"$swamp_bin" --version
"$deno_bin" --version
"$just_bin" --version
