#!/usr/bin/env bash
set -euo pipefail

readonly swamp_version="$(sed -n 's/^swampVersion: *//p' .swamp.yaml)"
readonly install_dir="${HOME}/.local/bin"
readonly swamp_bin="${install_dir}/swamp"
readonly deno_bin="${install_dir}/deno"
readonly just_bin="${install_dir}/just"

started_at=$SECONDS
echo "[orb setup] Ensuring swamp ${swamp_version} or newer is installed"

installed_version=""
if [[ -x "$swamp_bin" ]]; then
  installed_version="$($swamp_bin --version 2>/dev/null | sed -n 's/^swamp \([0-9.]*\).*/\1/p' || true)"
fi

if [[ -z "$installed_version" ]] ||
  [[ "$(printf '%s\n%s\n' "$swamp_version" "$installed_version" | sort -V | head -n 1)" != "$swamp_version" ]]; then
  mkdir -p "$install_dir"
  CI=1 curl -fsSL https://swamp.club/install.sh |
    CI=1 sh -s -- -d "$install_dir"
else
  echo "[orb setup] swamp ${installed_version} satisfies ${swamp_version}"
fi

echo "[orb setup] Exposing swamp's bundled deno"
doctor_output="$($swamp_bin doctor extensions --json)"
bundled_deno="$(sed -n 's/.*"denoPath": "\([^"]*\)".*/\1/p' <<<"$doctor_output")"
if [[ -z "$bundled_deno" || ! -x "$bundled_deno" ]]; then
  echo "[orb setup] Could not locate swamp's bundled deno" >&2
  exit 1
fi
ln -sfn "$bundled_deno" "$deno_bin"

echo "[orb setup] Ensuring just is installed"
if [[ ! -x "$just_bin" ]]; then
  uv tool install rust-just
fi

"$swamp_bin" --version
"$deno_bin" --version
"$just_bin" --version
echo "[orb setup] Complete in $((SECONDS - started_at))s"
